# Copy to .env (gitignored). Used by scripts and documents the GitHub Actions secrets.
# Never commit real values: this repo is public.

# AnyRouter API base (override for staging)
ANYROUTER_BASE_URL=https://anyrouter.dev/api/v1

# Apple signing (local scripts). In CI these are repository secrets with the same names.
APPLE_TEAM_ID=
IOS_CERT_P12_BASE64=
IOS_CERT_PASSWORD=
IOS_ADHOC_PROFILE_BASE64=
