// Copy to Config/Local.xcconfig (gitignored) to sign on your own device.
DEVELOPMENT_TEAM = YOUR_TEAM_ID
// Optional remote crash reporting (Sentry). Leave unset for a build that sends nothing.
// xcconfig treats // as a comment, so write the scheme as https:/$()/ :
// SENTRY_DSN = https:/$()/<key>@<host>/<project id>
